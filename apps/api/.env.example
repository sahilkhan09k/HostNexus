# ─── Server ──────────────────────────────────────────────────────────────
# Required, no default: development | production | test
NODE_ENV=development
PORT=5000
# Comma-separated browser origins allowed by CORS (required in production)
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the API (Render/Railway/Fly = 1, Cloudflare + LB = 2).
# Defaults to 1 in production. Never set this higher than the real hop count.
# TRUST_PROXY_HOPS=1

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────
# In production use the least-privilege app role (see prisma/sql/least-privilege-roles.sql),
# not the neondb_owner role. Always keep sslmode=require.
DATABASE_URL="postgresql://app_rw:password@ep-xxx-pooler.neon.tech/dbname?sslmode=require"
# Print every SQL query with parameters (development debugging only)
# PRISMA_LOG_QUERIES=false

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# All three must be different.
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-plus-character-secret
# Required in production. In development a separate key is derived from JWT_SECRET.
ADMIN_JWT_SECRET=replace-with-a-third-32-plus-character-secret

# ─── Payments (Razorpay) ─────────────────────────────────────────────────
# rzp_test_ keys outside production, rzp_live_ keys in production (enforced at startup)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# Dashboard → Webhooks: URL https://<api>/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ─── AI / KYC ────────────────────────────────────────────────────────────
# Set a monthly spend cap on each provider's dashboard.
GROQ_API_KEY=
# Separate key for GST certificate extraction so concierge traffic can't exhaust registration
GROQ_KYC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GSTIN_API_KEY=
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# ─── Seeding the first admin (pnpm db:seed) ──────────────────────────────
# Only read by prisma/seed.ts. Use a unique password of 16+ characters and remove
# these lines after seeding. Seeding production requires ALLOW_PROD_SEED=1.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=HostNexus Admin
