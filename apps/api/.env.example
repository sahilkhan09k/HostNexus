# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (Neon PostgreSQL)
# Run: npx neon@latest init
# This will automatically set up your DATABASE_URL
DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Authentication Configuration
# Generate a strong secret for production (minimum 32 characters)
JWT_SECRET="your-secret-key-minimum-32-characters-long-change-in-production"
