# Environment Configuration Example
# Copy this file to apps/api/.env and fill in the actual values

NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Razorpay Payment Gateway
# Test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL (used for CORS in production)
FRONTEND_URL=http://localhost:3000
